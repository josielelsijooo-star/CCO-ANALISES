# Copie este arquivo para .env e ajuste se precisar.
# Porta do servidor (acesse http://localhost:3000)
PORT=3000
# 0.0.0.0 deixa os outros PCs e a TV do CCO acessarem pelo IP desta máquina
HOST=0.0.0.0
# Onde fica o banco de dados e os prints anexados
DB_PATH=data/cco.db
ANEXOS_DIR=data/anexos
# Ponha true quando o servidor estiver atrás de HTTPS
COOKIE_SECURE=false
# Backup automático (a cada hora, um arquivo por dia) e quantos dias guardar
BACKUP_DIR=data/backups
BACKUP_DIAS=30
# Segunda cópia do backup em outro lugar (pasta de rede, pendrive, OneDrive). Vazio = não copia.
# Exemplo: BACKUP_COPIA=C:\Users\SEU_USUARIO\OneDrive\Backup CCO
BACKUP_COPIA=
